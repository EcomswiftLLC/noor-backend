PORT=8080
APP_ENV=development

# Obtain these from https://api-docs.quran.foundation after creating a free
# developer account. Leave unset and the backend runs fine - every route that
# needs them just returns {"available": false, "reason": "not_configured"}.
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# Only override these if Quran Foundation gives you different URLs
# (e.g. their prelive/staging environment while testing).
# QF_TOKEN_URL=https://oauth2.quran.foundation/oauth2/token
# QF_CONTENT_BASE_URL=https://apis.quran.foundation/content/api/v4

MIN_SUPPORTED_APP_VERSION=1.0.0

# Comma-separated origins if you ever add a web admin tool. Leave empty otherwise.
CORS_ORIGINS=
